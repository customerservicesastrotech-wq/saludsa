<?xml version="1.0" encoding="utf-8"?>
<!-- Privacidad: los registros, el PIN y la clave de IA se quedan solo en la tablet.
     Nada se sube a la copia de Google ni pasa a otro dispositivo; para mover los datos, usa Ajustes → Exportar copia. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
